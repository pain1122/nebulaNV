# -------------------------------------------
# Dependencies & build outputs (shrink context)
# -------------------------------------------
/node_modules
/node_modules/**
/apps/*/node_modules
/apps/*/node_modules/**
/packages/*/node_modules
/packages/*/node_modules/**

**/.ignored_*
**/node_modules
**/dist
**/.turbo
**/.nx
**/.vercel
**/.pnpm-store
**/.tsbuildinfo
/coverage
/.cache
/deploy
/.buildx-cache

# Documentation and tests are not backend image build inputs.
/docs
/my reports
/test
**/test
**/tests
**/__tests__
**/*.spec.ts
**/*.e2e-spec.ts
**/jest.config.*
**/tsconfig.spec.json
TODO.md
README.md
AI_CONTEXT.md
Setup.md
site essentials.md

# -------------------------------------------
# Local & IDE
# -------------------------------------------
.vscode
.idea
.DS_Store
Thumbs.db

# -------------------------------------------
# Environment & secrets
# Do not send real envs to the build context
# -------------------------------------------
.env
.env.*

# -------------------------------------------
# Logs & temp
# -------------------------------------------
*.log
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------------------
# VCS metadata
# -------------------------------------------
.git
.gitignore
.gitattributes

# -------------------------------------------
# Docker files (optional to exclude from context)
# (Docker still reads the specified Dockerfile path explicitly)
# -------------------------------------------
Dockerfile
docker-compose.yml
docker-compose.*.yml

# -------------------------------------------
# Prisma artifacts
# Keep migrations (needed for migrate deploy),
# exclude only generated client
# -------------------------------------------
**/prisma/generated
