{
  "name": "@nebula/protos",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "*.proto"
  ],
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "check-generated": "node ./scripts/generate.mjs --check",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "lint": "eslint \"index.ts\"",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "protoc": "^32.1.0",
    "ts-proto": "^2.7.7"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.9.0"
  }
}
