# ------------------------------------------
# 🌍 Environment and global behavior
# ------------------------------------------
NODE_ENV=development
PUBLIC_MODE=OPTIONAL_AUTH
HTTP_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------
# 🔐 Gateway + S2S security
# ------------------------------------------
S2S_SIGNATURE_HEADER=x-s2s-signature
S2S_MAX_CLOCK_SKEW_MS=30000
S2S_REPLAY_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# 🧩 Internal gRPC service registry
# (Docker resolves container names automatically)
# ------------------------------------------
USER_GRPC_URL=127.0.0.1:50051
AUTH_GRPC_URL=127.0.0.1:50052
PRODUCT_GRPC_URL=127.0.0.1:50053
SETTINGS_GRPC_URL=127.0.0.1:50054
BLOG_GRPC_URL=127.0.0.1:50055
ORDER_GRPC_URL=127.0.0.1:50056
TAXONOMY_GRPC_URL=127.0.0.1:50057
MEDIA_GRPC_URL=127.0.0.1:50058

USER_HTTP_PORT=3100
AUTH_HTTP_PORT=3001
PRODUCT_HTTP_PORT=3003
SETTINGS_HTTP_PORT=3010
BLOG_HTTP_PORT=3004
ORDER_HTTP_PORT=3005
TAXONOMY_HTTP_PORT=3006
MEDIA_HTTP_PORT=3007

# ------------------------------------------
# 🔑 Auth-service token signing
# ------------------------------------------
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ACCESS_SECRET=replace-with-32-plus-character-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-character-refresh-secret
BCRYPT_ROUNDS=10


MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
