# ------------------------------------------
# 🌍 Environment and global behavior
# ------------------------------------------
NODE_ENV=development
PUBLIC_MODE=OPTIONAL_AUTH
GATEWAY_HTTP_PORT=3002
GATEWAY_JSON_LIMIT_BYTES=262144
GATEWAY_RATE_LIMIT_TTL_MS=60000
GATEWAY_RATE_LIMIT_REQUESTS=120
GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_READINESS_TIMEOUT_MS=1500
GATEWAY_IDEMPOTENCY_TTL_SECONDS=86400
GATEWAY_IDEMPOTENCY_IN_FLIGHT_TTL_SECONDS=60
GATEWAY_IDEMPOTENCY_MAX_RESPONSE_BYTES=524288
GATEWAY_APPLICATION_REGISTRY_JSON=[{"clientId":"storefront-web-local","applicationId":"storefront-web-local","profile":"storefront-web","tenantId":"single-site-tenant","siteId":"single-site","channelId":"storefront-web","enabled":true,"origins":["http://localhost:3008"],"rateLimitProfile":"default"},{"clientId":"admin-web-local","applicationId":"admin-web-local","profile":"admin-web","tenantId":"single-site-tenant","siteId":"single-site","channelId":"admin-web","enabled":true,"origins":["http://localhost:3000"],"rateLimitProfile":"default"},{"clientId":"mobile-local","applicationId":"mobile-local","profile":"mobile","tenantId":"single-site-tenant","siteId":"single-site","channelId":"native-mobile","enabled":true,"origins":[],"rateLimitProfile":"default"}]
HTTP_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------
# 🔐 Gateway + S2S security
# ------------------------------------------
S2S_SIGNATURE_HEADER=x-s2s-signature
GATEWAY_OUTBOUND_KEYS={"auth-service":{"id":"gateway-auth-v1","secret":"dev-only-gateway-to-auth-s2s-key-00001"},"user-service":{"id":"gateway-user-v1","secret":"dev-only-gateway-to-user-s2s-key-00001"},"product-service":{"id":"gateway-product-v1","secret":"dev-only-gateway-to-product-s2s-key-001"},"settings-service":{"id":"gateway-settings-v1","secret":"dev-only-gateway-to-settings-s2s-key-001"},"blog-service":{"id":"gateway-blog-v1","secret":"dev-only-gateway-to-blog-s2s-key-00001"},"order-service":{"id":"gateway-order-v1","secret":"dev-only-gateway-to-order-s2s-key-0001"},"taxonomy-service":{"id":"gateway-taxonomy-v1","secret":"dev-only-gateway-to-taxonomy-s2s-key-001"},"media-service":{"id":"gateway-media-v1","secret":"dev-only-gateway-to-media-s2s-key-0001"}}
S2S_MAX_CLOCK_SKEW_MS=30000
S2S_REPLAY_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# 🧩 Internal gRPC service registry
# (Docker resolves container names automatically)
# ------------------------------------------
USER_GRPC_URL=127.0.0.1:50051
AUTH_GRPC_URL=127.0.0.1:50052
PRODUCT_GRPC_URL=127.0.0.1:50053
SETTINGS_GRPC_URL=127.0.0.1:50054
BLOG_GRPC_URL=127.0.0.1:50055
ORDER_GRPC_URL=127.0.0.1:50056
TAXONOMY_GRPC_URL=127.0.0.1:50057
MEDIA_GRPC_URL=127.0.0.1:50058
TENANT_AUTHORITY_GRPC_URL=127.0.0.1:50059
MEDIA_RENDER_HTTP_URL=http://127.0.0.1:3007

USER_HTTP_PORT=3100
AUTH_HTTP_PORT=3001
TENANT_AUTHORITY_HTTP_PORT=3011
TENANT_AUTHORITY_GRPC_PORT=50059
PRODUCT_HTTP_PORT=3003
SETTINGS_HTTP_PORT=3010
BLOG_HTTP_PORT=3004
ORDER_HTTP_PORT=3005
TAXONOMY_HTTP_PORT=3006
MEDIA_HTTP_PORT=3007

# ------------------------------------------
# 🔑 Auth-service token signing
# ------------------------------------------
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ACCESS_SECRET=replace-with-32-plus-character-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-character-refresh-secret
BCRYPT_ROUNDS=10

# Dedicated authority runtime login used by local Postgres initialization.
# It has no database/schema creation privilege and is not the migration owner.
AUTHORITY_DB_RUNTIME_PASSWORD=dev-only-authority-runtime-password
AUTHORITY_MEMBERSHIP_EPOCH_HMAC_KEY_ID=authority-membership-epoch-dev-v1
AUTHORITY_MEMBERSHIP_EPOCH_HMAC_KEY=dev-only-membership-epoch-hmac-key-000001

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
