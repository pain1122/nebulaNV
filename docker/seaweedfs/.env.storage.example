# Documentation only. Run seaweed-setup.mjs prepare to generate private settings.
# This opt-in preparation does not change the active root or Media environment.
# Only generated compose.env (port/origins) is passed to Compose. Never pass the
# private .env below to root/release Compose: its MEDIA values would repoint Media.
SEAWEED_HOST_PORT=19000
SEAWEED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEAWEED_ADMIN_ACCESS_KEY=generated-separately-from-media
SEAWEED_ADMIN_SECRET_KEY=generated-random-admin-secret
MEDIA_STORAGE_DRIVER=s3
MEDIA_STORAGE_PROVIDER=s3
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=media
MEDIA_S3_INTERNAL_ENDPOINT=http://seaweed:8333
MEDIA_S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
MEDIA_S3_ACCESS_KEY=generated-separately-from-admin
MEDIA_S3_SECRET_KEY=generated-random-media-secret
MEDIA_S3_FORCE_PATH_STYLE=true
