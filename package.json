{
  "name": "nebula-nv",
  "private": true,
  "nebula": {
    "backendServices": [
      {
        "name": "user-service",
        "packageName": "@nebula/user-service",
        "directory": "apps/user-service",
        "database": "nebula_users",
        "dockerService": "user-service",
        "defaultImage": "nebulanv-main-user-service:latest",
        "httpPort": 3100,
        "grpcPort": 50051,
        "moduleFile": "app.module.ts"
      },
      {
        "name": "auth-service",
        "packageName": "@nebula/auth-service",
        "directory": "apps/auth-service",
        "database": null,
        "dockerService": "auth-service",
        "defaultImage": "nebulanv-main-auth-service:latest",
        "httpPort": 3001,
        "grpcPort": 50052,
        "moduleFile": "app.module.ts"
      },
      {
        "name": "settings-service",
        "packageName": "@nebula/settings-service",
        "directory": "apps/settings-service",
        "database": "nebula_settings",
        "dockerService": "settings-service",
        "defaultImage": "nebulanv-main-settings-service:latest",
        "httpPort": 3010,
        "grpcPort": 50054,
        "moduleFile": "settings.module.ts"
      },
      {
        "name": "media-service",
        "packageName": "@nebula/media-service",
        "directory": "apps/media-service",
        "database": "nebula_media",
        "dockerService": "media-service",
        "defaultImage": "nebulanv-main-media-service:latest",
        "httpPort": 3007,
        "grpcPort": 50058,
        "moduleFile": "media.module.ts"
      },
      {
        "name": "taxonomy-service",
        "packageName": "@nebula/taxonomy-service",
        "directory": "apps/taxonomy-service",
        "database": "nebula_taxonomy",
        "dockerService": "taxonomy-service",
        "defaultImage": "nebulanv-main-taxonomy-service:latest",
        "httpPort": 3006,
        "grpcPort": 50057,
        "moduleFile": "app.module.ts"
      },
      {
        "name": "product-service",
        "packageName": "@nebula/product-service",
        "directory": "apps/product-service",
        "database": "nebula_products",
        "dockerService": "product-service",
        "defaultImage": "nebulanv-main-product-service:latest",
        "httpPort": 3003,
        "grpcPort": 50053,
        "moduleFile": "app.module.ts"
      },
      {
        "name": "blog-service",
        "packageName": "@nebula/blog-service",
        "directory": "apps/blog-service",
        "database": "nebula_blog",
        "dockerService": "blog-service",
        "defaultImage": "nebulanv-main-blog-service:latest",
        "httpPort": 3004,
        "grpcPort": 50055,
        "moduleFile": "app.module.ts"
      },
      {
        "name": "order-service",
        "packageName": "@nebula/order-service",
        "directory": "apps/order-service",
        "database": "nebula_order",
        "dockerService": "order-service",
        "defaultImage": "nebulanv-main-order-service:latest",
        "httpPort": 3005,
        "grpcPort": 50056,
        "moduleFile": "app.module.ts"
      }
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "build:backend": "node ./scripts/backend.mjs quality build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:backend": "node ./scripts/backend.mjs quality lint",
    "check-types": "turbo run check-types",
    "check-types:backend": "node ./scripts/backend.mjs quality check-types",
    "test:security": "pnpm --filter @nebula/grpc-auth test:security && pnpm --filter @nebula/auth-service test:security && pnpm --filter @nebula/media-service test:unit && pnpm --filter @nebula/order-service test:unit",
    "scan:dependencies:backend": "node ./scripts/backend.mjs security dependencies",
    "scan:source:backend": "node ./scripts/backend.mjs security source",
    "scan:images:backend": "node ./scripts/backend.mjs security images",
    "backend:env": "node ./scripts/backend.mjs environment",
    "backend:boot": "node ./scripts/backend.mjs boot",
    "backend:health": "node ./scripts/backend.mjs health",
    "backend:down": "node ./scripts/backend.mjs down",
    "test:e2e:provision": "node ./scripts/backend.mjs boot",
    "test:e2e": "pnpm build:backend && pnpm -r --workspace-concurrency=1 --filter=./apps/* --if-present run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\"",
    "proto:gen": "pnpm --filter @nebula/protos generate",
    "proto:check": "pnpm --filter @nebula/protos check-generated",
    "docker:build:backend": "node ./scripts/backend.mjs build-images",
    "docker:build:backend:clean": "node ./scripts/backend.mjs build-images --clean",
    "prisma:gen": "node ./scripts/backend.mjs prisma generate",
    "prisma:migrate:dev": "node ./scripts/backend.mjs prisma migrate-dev",
    "prisma:migrate:deploy": "node ./scripts/backend.mjs prisma migrate-deploy",
    "prisma:migrate:status": "node ./scripts/backend.mjs prisma migrate-status",
    "prisma:seed": "node ./scripts/backend.mjs prisma seed",
    "backend:seed": "node ./scripts/backend.mjs seed",
    "db:push": "node ./scripts/backend.mjs prisma push",
    "db:verify:migrations": "node ./scripts/backend.mjs database verify-migrations",
    "db:backup": "node ./scripts/backend.mjs database backup",
    "db:restore": "node ./scripts/backend.mjs database restore",
    "test:database-recovery": "node ./scripts/backend.mjs database test-recovery",
    "test:backend-tooling": "node --test ./scripts/backend.test.mjs",
    "dev:auth": "pnpm --filter ./apps/auth-service start",
    "dev:user": "wait-on tcp:127.0.0.1:50052 && pnpm --filter ./apps/user-service start",
    "dev:settings": "wait-on tcp:127.0.0.1:50052 && pnpm --filter ./apps/settings-service start",
    "dev:taxonomy": "wait-on tcp:127.0.0.1:50052 tcp:127.0.0.1:50054 && pnpm --filter ./apps/taxonomy-service start",
    "dev:media": "wait-on tcp:127.0.0.1:50052 && pnpm --filter ./apps/media-service start",
    "dev:blog": "wait-on tcp:127.0.0.1:50052 tcp:127.0.0.1:50054 tcp:127.0.0.1:50057 && pnpm --filter ./apps/blog-service start",
    "dev:product": "wait-on tcp:127.0.0.1:50052 tcp:127.0.0.1:50054 tcp:127.0.0.1:50057 && pnpm --filter ./apps/product-service start",
    "dev:order": "wait-on tcp:127.0.0.1:50052 tcp:127.0.0.1:50054 tcp:127.0.0.1:50053 && pnpm --filter ./apps/order-service start",
    "dev:backend": "node ./scripts/backend.mjs dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:all": "concurrently -k \"pnpm run dev:backend\""
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "nx": "^21.5.3",
    "prettier": "^3.6.2",
    "prisma": "6.16.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.9.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nebula/clients": "workspace:*",
    "@nebula/grpc-auth": "workspace:*",
    "@nebula/protos": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.16.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "wait-on": "^9.0.3"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/testing": "11.1.28",
      "@aws-sdk/xml-builder>fast-xml-parser": "5.5.6",
      "router>path-to-regexp": "8.4.2",
      "fstream": ">=1.0.13",
      "npmlog": "^7.0.1",
      "gauge": "^5.0.0",
      "are-we-there-yet": "^3.0.1",
      "inflight": "^2.0.0",
      "node-domexception": "^2.0.0",
      "glob": "^10.4.5",
      "rimraf": "^6.0.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "bcrypt",
      "prisma",
      "protobufjs",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "nx"
    ]
  }
}
