generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum AccessClass {
  PUBLIC
  PROTECTED
  STRICT
}

enum MediaStatus {
  PENDING
  READY
  BLOCKED
  DELETED
}

enum ScanStatus {
  NONE
  QUEUED
  SCANNING
  CLEAN
  INFECTED
  FAILED
}

enum MediaJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Media {
  id String @id @default(uuid()) @db.Uuid

  storage          String  @default("local")
  bucket           String?
  path             String
  filename         String
  folderPath       String  @default("/")
  displayName      String  @default("")
  title            String?
  defaultAlt       String?
  metadataVersion  Int     @default(1)
  originalFilename String?
  mimeType         String
  sizeBytes        Int

  width       Int?
  height      Int?
  durationSec Int?

  ownerId         String?     @db.Uuid
  identityRealmId String?     @db.Uuid
  subjectId       String?     @db.Uuid
  visibility      String      @default("private")
  scope           String      @default("panel")
  entityType      String?
  entityId        String?
  // Define access restrictions (PUBLIC, PROTECTED, STRICT)
  accessClass     AccessClass @default(PUBLIC)

  sha256 String? @unique

  // ✅ lifecycle + malware pipeline
  status     MediaStatus @default(PENDING)
  scanStatus ScanStatus  @default(NONE)
  scannedAt  DateTime?
  scanError  String?

  // ✅ requested fields
  quarantineReason String? // why blocked/quarantined
  etag             String? // storage metadata to lock integrity
  promotedAt       DateTime? // when moved from pending -> ready path

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processingJob         MediaProcessingJob?
  verifiedSource        MediaVerifiedSource?
  derivativeGenerations MediaDerivativeGeneration[]
  derivativeState       MediaDerivativeState?
  derivatives           MediaDerivative[]

  @@index([ownerId])
  @@index([identityRealmId, subjectId])
  @@index([accessClass])
  @@index([visibility])
  @@index([scope])
  @@index([entityType, entityId])
  @@index([scope, entityType, entityId])
  @@index([ownerId, scope, entityType, entityId])
  @@index([folderPath])
  @@index([displayName])
  @@index([scope, folderPath])
  @@index([status])
  @@index([scanStatus])
  @@index([promotedAt])
}

model MediaProcessingJob {
  id                    String         @id @default(uuid()) @db.Uuid
  mediaId               String         @unique @db.Uuid
  media                 Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  status                MediaJobStatus @default(QUEUED)
  attempts              Int            @default(0)
  maxAttempts           Int            @default(5)
  availableAt           DateTime       @default(now())
  leaseToken            String?        @db.Uuid
  leaseUntil            DateTime?
  expectedSha256        String?
  expectedUploadBinding String?
  lastError             String?
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([status, availableAt])
  @@index([status, leaseUntil])
}

// The checksum is not globally unique: identical bytes can have distinct owners.
// New uploads never use the legacy client-claimed Media.sha256 as verified fact.
model MediaVerifiedSource {
  mediaId   String   @id @db.Uuid
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  bucket    String
  path      String   @unique
  sha256    String
  mimeType  String
  sizeBytes Int
  width     Int
  height    Int
  scanner   String
  scannedAt DateTime
  createdAt DateTime @default(now())

  @@index([sha256])
}

// Register a copy before PUT. A lost claim, crash, or deletion leaves a durable
// cleanup record; successful publication removes it in the same transaction.
model MediaObjectCleanup {
  id          String   @id @default(uuid()) @db.Uuid
  bucket      String
  path        String
  availableAt DateTime
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())

  @@unique([bucket, path])
  @@index([availableAt])
}

model MediaDerivativeGeneration {
  id           String                 @id @default(uuid()) @db.Uuid
  mediaId      String                 @db.Uuid
  media        Media                  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  requestHash  String
  sourceSha256 String
  recipes      Json
  watermarks   Json
  fontSha256   String?
  status       MediaJobStatus         @default(QUEUED)
  attempts     Int                    @default(0)
  maxAttempts  Int                    @default(5)
  availableAt  DateTime               @default(now())
  leaseToken   String?                @db.Uuid
  leaseUntil   DateTime?
  lastError    String?
  completedAt  DateTime?
  retiredAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  outputs      MediaDerivative[]
  desiredFor   MediaDerivativeState[] @relation("DesiredDerivativeGeneration")
  approvedFor  MediaDerivativeState[] @relation("ApprovedDerivativeGeneration")

  @@unique([id, mediaId])
  @@index([mediaId, createdAt])
  @@index([status, availableAt])
  @@index([status, leaseUntil])
}

model MediaDerivativeState {
  mediaId              String                     @id @db.Uuid
  media                Media                      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  desiredGenerationId  String?                    @db.Uuid
  desiredGeneration    MediaDerivativeGeneration? @relation("DesiredDerivativeGeneration", fields: [desiredGenerationId, mediaId], references: [id, mediaId], onDelete: NoAction)
  approvedGenerationId String?                    @db.Uuid
  approvedGeneration   MediaDerivativeGeneration? @relation("ApprovedDerivativeGeneration", fields: [approvedGenerationId, mediaId], references: [id, mediaId], onDelete: NoAction)
  updatedAt            DateTime                   @updatedAt
}

model MediaDerivative {
  id               String                    @id @default(uuid()) @db.Uuid
  mediaId          String                    @db.Uuid
  media            Media                     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  generationId     String                    @db.Uuid
  generation       MediaDerivativeGeneration @relation(fields: [generationId, mediaId], references: [id, mediaId], onDelete: Cascade)
  view             String
  recipe           Json
  recipeHash       String
  processorVersion String
  sourceSha256     String
  watermarkMediaId String?                   @db.Uuid
  watermarkSha256  String?
  fontSha256       String?
  fontFamily       String?
  bucket           String
  path             String                    @unique
  sha256           String
  mimeType         String
  width            Int
  height           Int
  sizeBytes        Int
  createdAt        DateTime                  @default(now())

  @@unique([generationId, view])
  @@index([mediaId])
  @@index([watermarkMediaId])
}
