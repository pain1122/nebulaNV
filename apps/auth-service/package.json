  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --config ./jest.config.ts --runInBand",
    "test:security": "jest --config ./jest.security.config.ts --runInBand",
    "test:watch": "jest --watch --config ./jest.config.ts",
    "test:cov": "jest --coverage --config ./jest.config.ts",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config ./jest.config.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "export:f4-r3-families": "ts-node --project tsconfig.json src/auth/migration/export-f4-r3-families.ts"
  },
  "dependencies": {
    "@nebula/migration-artifacts": "workspace:^",
    "@bufbuild/protobuf": "^2.9.0",
