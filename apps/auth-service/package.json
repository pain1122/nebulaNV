    "@nebula/grpc-auth": "workspace:^",
    "@nebula/protos": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "11.1.28",
