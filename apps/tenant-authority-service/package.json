{
  "name": "@nebula/tenant-authority-service",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "prisma:gen": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema ./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema ./prisma/schema.prisma",
    "db:seed": "prisma db seed --schema ./prisma/schema.prisma",
    "verify:batch2-exit": "ts-node --project tsconfig.json prisma/verify-batch2-exit.ts",
    "backfill:f4-legacy-roles": "ts-node --project tsconfig.json prisma/backfill-f4-legacy-roles.ts",
    "backfill:f4-default-actors": "ts-node --project tsconfig.json prisma/backfill-f4-default-actors.ts",
    "seed:f4-default-role-fixtures": "ts-node --project tsconfig.json prisma/seed-f4-default-role-fixtures.ts",
    "verify:batch3-actor-resolution": "ts-node --project tsconfig.json prisma/verify-batch3-actor-resolution.ts",
    "db:push": "prisma db push --schema ./prisma/schema.prisma",
    "test": "jest --config ./jest.config.ts --runInBand",
    "test:unit": "jest --config ./jest.config.ts --runInBand",
    "postinstall": "pnpm run prisma:gen"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/microservices": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@grpc/grpc-js": "^1.14.4",
    "@nebula/grpc-auth": "workspace:*",
    "@nebula/protos": "workspace:*",
    "@packages/config": "workspace:*",
    "@prisma/client": "6.16.2",
    "express": "5.2.1",
    "joi": "18.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "11.1.28",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jest": "30.2.0",
    "prettier": "^3.6.2",
    "prisma": "6.16.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.2"
  }
}
