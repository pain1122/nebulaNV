# Tenant-authority local development example. The HTTP listener owns health;
# typed authority reads use a separately signed internal gRPC listener.
# Migration tooling still uses the root administrative inventory connection.

NODE_ENV=development
PORT=3011
GRPC_PORT=50059
AUTH_GRPC_URL=127.0.0.1:50052
SVC_NAME=tenant-authority-service
PUBLIC_MODE=GATEWAY_ONLY
S2S_SIGNATURE_HEADER=x-s2s-signature
S2S_MAX_CLOCK_SKEW_MS=30000
S2S_REPLAY_STORE=redis
S2S_OUTBOUND_KEYS={}
S2S_INBOUND_KEYS={}
GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-tenant-authority-v1","secret":"dev-only-gateway-to-tenant-authority-key-0001"}}}
AUTHORITY_AUDIT_HMAC_KEY_ID=authority-audit-dev-v1
AUTHORITY_AUDIT_HMAC_KEY=dev-only-authority-audit-hmac-key-00000001
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
DATABASE_URL=postgresql://nebula_authority_runtime:dev-only-authority-runtime-password@127.0.0.1:15432/nebula_authority?schema=public
