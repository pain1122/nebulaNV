# Default-realm shadow deployment. The operator deployment uses the OPERATOR
# tuple frozen in src/config/realm-deployments.ts and a separate DB/role/Redis.
NODE_ENV=development
REALM_AUTH_DEPLOYMENT=DEFAULT
REALM_AUTH_HTTP_PORT=3012
REALM_AUTH_IDENTITY_REALM_ID=b1000000-0000-4000-8000-000000000001
REALM_AUTH_ROUTE_REF=b1100000-0000-4000-8000-000000000001
REALM_AUTH_ISSUER=urn:nebula:realm-auth:b1000000-0000-4000-8000-000000000001
REALM_AUTH_REDIS_URL=redis://127.0.0.1:6381/0
DATABASE_URL=postgresql://nebula_realm_auth_default_runtime:dev-only-realm-auth-default-password@127.0.0.1:15432/nebula_realm_auth_default?schema=public
