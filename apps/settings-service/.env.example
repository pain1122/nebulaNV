DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nebula_settings?schema=public
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=nebula_settings_shadow"
SVC_NAME=settings-service
PORT=3010
GRPC_PORT=50054
S2S_OUTBOUND_KEYS={"auth-service":{"id":"settings-auth-v1","secret":"dev-only-settings-to-auth-s2s-key-0001"}}
S2S_INBOUND_KEYS={"product-service":{"current":{"id":"product-settings-v1","secret":"dev-only-product-to-settings-s2s-key-0001"}},"blog-service":{"current":{"id":"blog-settings-v1","secret":"dev-only-blog-to-settings-s2s-key-000001"}},"taxonomy-service":{"current":{"id":"taxonomy-settings-v1","secret":"dev-only-taxonomy-to-settings-s2s-key-01"}},"order-service":{"current":{"id":"order-settings-v1","secret":"dev-only-order-to-settings-s2s-key-00001"}}}
GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-settings-v1","secret":"dev-only-gateway-to-settings-s2s-key-001"}}}
