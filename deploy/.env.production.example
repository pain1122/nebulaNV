# Copy this file to deploy/.env.production on the deployment machine.
# Keep real production secrets out of git.

NEBULA_IMAGE_PREFIX=nebulanv-main
NEBULA_IMAGE_TAG=latest

NODE_ENV=production
PUBLIC_MODE=GATEWAY_ONLY

# Public API boundary. Container port 3002 remains fixed; change only the host
# port when the deployment needs a different published listener.
GATEWAY_HOST_PORT=3002
GATEWAY_HTTP_PORT=3002
GATEWAY_JSON_LIMIT_BYTES=262144
GATEWAY_RATE_LIMIT_TTL_MS=60000
GATEWAY_RATE_LIMIT_REQUESTS=120
GATEWAY_READINESS_TIMEOUT_MS=1500
GATEWAY_IDEMPOTENCY_TTL_SECONDS=86400
GATEWAY_IDEMPOTENCY_IN_FLIGHT_TTL_SECONDS=60
GATEWAY_IDEMPOTENCY_MAX_RESPONSE_BYTES=524288
GATEWAY_APPLICATION_REGISTRY_JSON=[{"clientId":"storefront-web-production","applicationId":"storefront-web-production","profile":"storefront-web","tenantId":"single-site-tenant","siteId":"single-site","channelId":"storefront-web","enabled":true,"origins":["https://storefront.example.com"],"rateLimitProfile":"default"},{"clientId":"admin-web-production","applicationId":"admin-web-production","profile":"admin-web","tenantId":"single-site-tenant","siteId":"single-site","channelId":"admin-web","enabled":true,"origins":["https://admin.example.com"],"rateLimitProfile":"default"},{"clientId":"mobile-production","applicationId":"mobile-production","profile":"mobile","tenantId":"single-site-tenant","siteId":"single-site","channelId":"native-mobile","enabled":true,"origins":[],"rateLimitProfile":"default"}]

# Gateway downstream control-plane targets on the private Compose network.
AUTH_GRPC_URL=auth-service:50052
USER_GRPC_URL=user-service:50051
PRODUCT_GRPC_URL=product-service:50053
SETTINGS_GRPC_URL=settings-service:50054
BLOG_GRPC_URL=blog-service:50055
ORDER_GRPC_URL=order-service:50056
TAXONOMY_GRPC_URL=taxonomy-service:50057
MEDIA_GRPC_URL=media-service:50058
TENANT_AUTHORITY_GRPC_URL=tenant-authority-service:50059
# Leave empty for gateway-only production. Use exact comma-separated origins only
# when browsers intentionally call a backend service directly.
HTTP_CORS_ORIGINS=

# Use independent random values for every caller -> target edge.
S2S_SIGNATURE_HEADER=x-s2s-signature
GATEWAY_OUTBOUND_KEYS={"auth-service":{"id":"gateway-auth-v1","secret":"replace-gateway-auth-random-32-byte-key"},"user-service":{"id":"gateway-user-v1","secret":"replace-gateway-user-random-32-byte-key"},"product-service":{"id":"gateway-product-v1","secret":"replace-gateway-product-random-32-key"},"settings-service":{"id":"gateway-settings-v1","secret":"replace-gateway-settings-random-32-key"},"blog-service":{"id":"gateway-blog-v1","secret":"replace-gateway-blog-random-32-byte-key"},"order-service":{"id":"gateway-order-v1","secret":"replace-gateway-order-random-32-byte-key"},"taxonomy-service":{"id":"gateway-taxonomy-v1","secret":"replace-gateway-taxonomy-random-32-key"},"media-service":{"id":"gateway-media-v1","secret":"replace-gateway-media-random-32-byte-key"}}
S2S_MAX_CLOCK_SKEW_MS=30000
S2S_REPLAY_STORE=redis
JWT_ACCESS_SECRET=replace-with-32-plus-character-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-character-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=12

# Rotation format: add a previous {id,secret,notAfter} object beside current.
AUTH_S2S_OUTBOUND_KEYS={"auth-service":{"id":"auth-auth-v1","secret":"replace-auth-auth-with-random-32-byte-key"},"user-service":{"id":"auth-user-v1","secret":"replace-auth-user-with-random-32-byte-key"}}
AUTH_S2S_INBOUND_KEYS={"auth-service":{"current":{"id":"auth-auth-v1","secret":"replace-auth-auth-with-random-32-byte-key"}},"user-service":{"current":{"id":"user-auth-v1","secret":"replace-user-auth-with-random-32-byte-key"}},"settings-service":{"current":{"id":"settings-auth-v1","secret":"replace-settings-auth-random-32-byte-key"}},"blog-service":{"current":{"id":"blog-auth-v1","secret":"replace-blog-auth-with-random-32-byte-key"}},"product-service":{"current":{"id":"product-auth-v1","secret":"replace-product-auth-random-32-byte-key"}},"media-service":{"current":{"id":"media-auth-v1","secret":"replace-media-auth-with-random-32-byte-key"}},"taxonomy-service":{"current":{"id":"taxonomy-auth-v1","secret":"replace-taxonomy-auth-random-32-byte-key"}},"order-service":{"current":{"id":"order-auth-v1","secret":"replace-order-auth-with-random-32-byte-key"}}}
AUTH_GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-auth-v1","secret":"replace-gateway-auth-random-32-byte-key"}}}

USER_S2S_OUTBOUND_KEYS={"auth-service":{"id":"user-auth-v1","secret":"replace-user-auth-with-random-32-byte-key"}}
USER_S2S_INBOUND_KEYS={"auth-service":{"current":{"id":"auth-user-v1","secret":"replace-auth-user-with-random-32-byte-key"}}}
USER_GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-user-v1","secret":"replace-gateway-user-random-32-byte-key"}}}

SETTINGS_S2S_OUTBOUND_KEYS={"auth-service":{"id":"settings-auth-v1","secret":"replace-settings-auth-random-32-byte-key"}}
SETTINGS_S2S_INBOUND_KEYS={"product-service":{"current":{"id":"product-settings-v1","secret":"replace-product-settings-random-32-key"}},"blog-service":{"current":{"id":"blog-settings-v1","secret":"replace-blog-settings-random-32-byte-key"}},"taxonomy-service":{"current":{"id":"taxonomy-settings-v1","secret":"replace-taxonomy-settings-random-32-key"}},"order-service":{"current":{"id":"order-settings-v1","secret":"replace-order-settings-random-32-byte-key"}}}
SETTINGS_GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-settings-v1","secret":"replace-gateway-settings-random-32-key"}}}

TAXONOMY_S2S_OUTBOUND_KEYS={"auth-service":{"id":"taxonomy-auth-v1","secret":"replace-taxonomy-auth-random-32-byte-key"},"settings-service":{"id":"taxonomy-settings-v1","secret":"replace-taxonomy-settings-random-32-key"}}
TAXONOMY_S2S_INBOUND_KEYS={"product-service":{"current":{"id":"product-taxonomy-v1","secret":"replace-product-taxonomy-random-32-key"}},"blog-service":{"current":{"id":"blog-taxonomy-v1","secret":"replace-blog-taxonomy-random-32-byte-key"}}}
TAXONOMY_GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-taxonomy-v1","secret":"replace-gateway-taxonomy-random-32-key"}}}

PRODUCT_S2S_OUTBOUND_KEYS={"auth-service":{"id":"product-auth-v1","secret":"replace-product-auth-random-32-byte-key"},"settings-service":{"id":"product-settings-v1","secret":"replace-product-settings-random-32-key"},"taxonomy-service":{"id":"product-taxonomy-v1","secret":"replace-product-taxonomy-random-32-key"}}
PRODUCT_S2S_INBOUND_KEYS={"order-service":{"current":{"id":"order-product-v1","secret":"replace-order-product-random-32-byte-key"}}}
PRODUCT_GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-product-v1","secret":"replace-gateway-product-random-32-key"}}}

BLOG_S2S_OUTBOUND_KEYS={"auth-service":{"id":"blog-auth-v1","secret":"replace-blog-auth-with-random-32-byte-key"},"settings-service":{"id":"blog-settings-v1","secret":"replace-blog-settings-random-32-byte-key"},"taxonomy-service":{"id":"blog-taxonomy-v1","secret":"replace-blog-taxonomy-random-32-byte-key"}}
BLOG_S2S_INBOUND_KEYS={}
BLOG_GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-blog-v1","secret":"replace-gateway-blog-random-32-byte-key"}}}

ORDER_S2S_OUTBOUND_KEYS={"auth-service":{"id":"order-auth-v1","secret":"replace-order-auth-with-random-32-byte-key"},"settings-service":{"id":"order-settings-v1","secret":"replace-order-settings-random-32-byte-key"},"product-service":{"id":"order-product-v1","secret":"replace-order-product-random-32-byte-key"}}
ORDER_S2S_INBOUND_KEYS={}
ORDER_GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-order-v1","secret":"replace-gateway-order-random-32-byte-key"}}}

MEDIA_S2S_OUTBOUND_KEYS={"auth-service":{"id":"media-auth-v1","secret":"replace-media-auth-with-random-32-byte-key"}}
MEDIA_S2S_INBOUND_KEYS={}
MEDIA_GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-media-v1","secret":"replace-gateway-media-random-32-byte-key"}}}
TENANT_AUTHORITY_S2S_INBOUND_KEYS={}
TENANT_AUTHORITY_GATEWAY_INBOUND_KEYS={"gateway":{"current":{"id":"gateway-tenant-authority-v1","secret":"replace-gateway-tenant-authority-random-key"}}}
AUTHORITY_AUDIT_HMAC_KEY_ID=authority-audit-production-v1
AUTHORITY_AUDIT_HMAC_KEY=replace-authority-audit-with-random-32-byte-key
AUTHORITY_MEMBERSHIP_EPOCH_HMAC_KEY_ID=authority-membership-epoch-production-v1
AUTHORITY_MEMBERSHIP_EPOCH_HMAC_KEY=replace-membership-epoch-with-random-32-byte-key
MEDIA_DELETE_CONFIRM_SECRET=replace-media-delete-confirm-with-random-32-byte-key

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=nebula
AUTHORITY_DB_RUNTIME_PASSWORD=replace-authority-runtime-with-random-password
REALM_AUTH_DEFAULT_DB_RUNTIME_PASSWORD=replace-default-realm-auth-runtime-with-random-password
REALM_AUTH_OPERATOR_DB_RUNTIME_PASSWORD=replace-operator-realm-auth-runtime-with-random-password
REALM_AUTH_DEFAULT_REDIS_PASSWORD=replace-default-realm-auth-redis-with-random-password
REALM_AUTH_OPERATOR_REDIS_PASSWORD=replace-operator-realm-auth-redis-with-random-password

REDIS_PASSWORD=replace-with-a-random-redis-password
GATEWAY_REDIS_URL=redis://:replace-with-a-random-redis-password@redis:6379/0

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_HOST_PORT=9000

MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=media
MEDIA_STORAGE_PROVIDER=minio
MEDIA_S3_INTERNAL_ENDPOINT=http://minio:9000
MEDIA_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=change-me-minio-password
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_SIGNED_UPLOAD_TTL_SECONDS=600
MEDIA_SIGNED_READ_TTL_SECONDS=300
MEDIA_STRICT_READ_TTL_SECONDS=30
MEDIA_SYNC_DELETE_MAX_FILES=500
MEDIA_PUBLIC_FOLDER=uploads
MEDIA_PRIVATE_FOLDER=private/objects
MEDIA_RENDER_HTTP_URL=http://media-service:3007
